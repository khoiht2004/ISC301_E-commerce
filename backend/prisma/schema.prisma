generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id                 Int       @id @default(autoincrement())
  fullName           String
  email              String    @unique
  password           String
  phone              String?
  avatar             String?
  address            String?
  role               Role      @default(USER) // ADMIN | STAFF | USER
  isOnline           Boolean   @default(false)
  isActive           Boolean   @default(true)
  isVerified         Boolean   @default(false)
  verifyToken        String?
  refreshToken       String?
  refreshTokenExpiry DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders      Order[]
  addresses   Address[]
  cart        Cart?
  news        News[]
  products    Product[]
  userProfile UserProfile?

  reviews    ProductReview[]
  complaints OrderComplaint[]

  // Relations for Support Chat
  supportRequests SupportRequest[] @relation("UserRequests")
  assignedSupport SupportRequest[] @relation("StaffSupportRequests")
  messages        Message[]

  @@map("user")
}

model UserProfile {
  id          Int       @id @default(autoincrement())
  gender      String?
  dateOfBirth DateTime?
  bio         String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  address     String?  @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
  batches  ProductBatch[]

  @@map("supplier")
}

model Address {
  id        Int      @id @default(autoincrement())
  fullName  String
  phone     String
  province  String
  district  String
  ward      String
  detail    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("address")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("category")
}

// ─── PRODUCT TAG SYSTEM ───────────────────────────────────────────────────────

model ProductTag {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  products ProductTagOnProduct[]

  @@map("product_tag")
}

model ProductTagOnProduct {
  productId Int
  tagId     Int

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tag_on_product")
}

// ─── PRODUCT ──────────────────────────────────────────────────────────────────

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?
  thumbnail        String?
  images           String   @default("[]") // JSON array as string
  price            Int
  salePrice        Int?
  stock            Int      @default(0)
  sku              String?  @unique
  unit             String   @default("gram")
  weight           Int?
  isPublished      Boolean  @default(false)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  tags       ProductTagOnProduct[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  batches    ProductBatch[]
  reviews    ProductReview[]

  @@index([createdById])
  @@index([isDeleted, isPublished])
  @@map("product")
}

model ProductBatch {
  id              Int       @id @default(autoincrement())
  batchCode       String    @unique
  importQuantity  Int
  currentQuantity Int       @default(0)
  costPrice       Int // Giá nhập
  manufactureDate DateTime?
  expirationDate  DateTime
  importDate      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([expirationDate])
  @@map("product_batch")
}

model ProductReview {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("product_review")
}

// ─── CART ─────────────────────────────────────────────────────────────────────

model Cart {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@map("cart")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_item")
}

// ─── ORDER ────────────────────────────────────────────────────────────────────

model Order {
  id              Int           @id @default(autoincrement())
  orderCode       String        @unique
  subtotal        Int
  shippingFee     Int           @default(0)
  discountAmount  Int           @default(0)
  totalAmount     Int
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PENDING)
  shippingAddress String
  customerPhone   String
  customerEmail   String
  note            String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?

  userId              Int
  user                User                 @relation(fields: [userId], references: [id])
  orderItems          OrderItem[]
  paymentTransactions PaymentTransaction[]
  reviews             ProductReview[]
  complaints          OrderComplaint[]

  @@map("order")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  quantity     Int
  price        Int
  productName  String
  productImage String?

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_item")
}

model OrderComplaint {
  id         Int             @id @default(autoincrement())
  reason     String          @db.Text
  status     ComplaintStatus @default(PENDING)
  resolution String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_complaint")
}

model Coupon {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  discountType String
  value        Int
  startAt      DateTime
  endAt        DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("coupon")
}

// ─── NEWS ─────────────────────────────────────────────────────────────────────

model News {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.LongText
  thumbnail   String?
  views       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  @@map("news")
}

// ─── SUPPORT CHAT MODELS ──────────────────────────────────────────────────────

model SupportRequest {
  id         Int           @id @default(autoincrement())
  status     SupportStatus @default(WAITING)
  title      String?
  createdAt  DateTime      @default(now())
  acceptedAt DateTime?
  closedAt   DateTime?
  updatedAt  DateTime      @updatedAt

  userId Int
  user   User @relation("UserRequests", fields: [userId], references: [id])

  assignedStaffId Int?
  assignedStaff   User? @relation("StaffSupportRequests", fields: [assignedStaffId], references: [id])

  messages Message[]

  @@map("support_request")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  supportRequestId Int
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation(fields: [senderId], references: [id])

  @@map("message")
}

model PaymentTransaction {
  id            Int      @id @default(autoincrement())
  orderId       Int
  transactionId String   @unique
  gateway       String
  amount        Int
  content       String
  rawData       String   @db.Text
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_transaction")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  USER
}

enum ComplaintStatus {
  PENDING
  RESOLVING
  RESOLVED
  REJECTED
}

enum SupportStatus {
  WAITING
  ACTIVE
  COMPLETED
  CLOSED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
  VNPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
}
